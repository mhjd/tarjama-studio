{
  "name": "tarjama-studio-ui",
  "private": true,
  "version": "0.1.27",
  "description": "Local-first Arabic transcription and translation reviewer",
  "author": "Tarjama Studio",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:build": "tsc -p tsconfig.electron.json",
    "desktop:tools": "python3 ../scripts/prepare_desktop_tools.py",
    "desktop:prepare": "python3 ../scripts/prepare_desktop_config.py",
    "desktop:build": "npm run desktop:prepare && npm run build && npm run electron:build",
    "desktop:dev": "npm run desktop:tools && npm run desktop:prepare && npm run electron:build && electron dist-electron/main.js",
    "desktop:package": "npm run desktop:tools && npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:tools && npm run desktop:build && electron-builder"
  },
  "build": {
    "appId": "studio.tarjama.reviewer",
    "productName": "Tarjama Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-bin",
        "to": "desktop-bin"
      },
      {
        "from": "../prompts",
        "to": "prompts"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
