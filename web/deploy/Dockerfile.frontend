# UI-only release: retain the exact qualified API/worker binary and runtime.
# The build script verifies this local base against the imported image catalogue.
ARG QUALIFIED_RUNTIME
FROM node:22.23.2-bookworm-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM ${QUALIFIED_RUNTIME}
COPY --from=frontend /src/frontend/dist /app/frontend
