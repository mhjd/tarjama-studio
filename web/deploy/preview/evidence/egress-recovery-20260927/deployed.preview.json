{
  "configs": {
    "deploy-backup": {
      "backup.sh": "#!/bin/sh\nset -eu\numask 077\nexport PGHOST=pv-db PGPORT=5432 PGDATABASE=tarjama PGUSER=tarjama PGCONNECT_TIMEOUT=3\nexport PGPASSWORD=\"$(cat /run/db/app_db_password)\"\nfor attempt in $(seq 1 30); do\n  if psql -X -w -Atqc 'SELECT 1' >/dev/null 2>/tmp/db-ready.err; then break; fi\n  sleep 2\ndone\npsql -X -w -Atqc 'SELECT 1' >/dev/null\nmkdir -p /storage/backups\nout=/storage/backups/pre-reliability-$(date -u +%Y%m%dT%H%M%SZ).dump\nset -C\n: > \"$out\"\nset +C\npg_dump -w -Fc > \"$out\"\npg_restore --list \"$out\" >/dev/null\nsha256sum \"$out\"\nprintf 'Backup complete; no media modified.\\n'\n"
    },
    "postgres-client": {
      "pg_service.conf": "[preview-init]\nhost=/tmp\n"
    }
  },
  "jobs": {
    "backup": {
      "args": [
        "/configuration/backup.sh"
      ],
      "command": [
        "/bin/sh"
      ],
      "configs": [
