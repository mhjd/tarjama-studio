[
  {
    "id": "76c90f69b584ef86060ae277e1376c22",
    "start_ms": 388260,
    "end_ms": 392300,
    "arabic": "ولذلك أكثر الفئات المظلومة بشكل عام"
  },
  {
    "id": "0a1b5d320bdb2df6bf495759553f9f57",
    "start_ms": 392300,
    "end_ms": 394340,
    "arabic": "عبر التاريخ هم النساء"
  },
  {
    "id": "ed4f3bda2971efee3a75004311048188",
    "start_ms": 394340,
    "end_ms": 396760,
    "arabic": "وهم العبيد"
  },
  {
    "id": "da6d0eca0a68cdec92055fab1e7c6754",
    "start_ms": 396760,
    "end_ms": 398300,
    "arabic": "وهم الأطفال"
  },
  {
    "id": "5cec197d6541dac7a1895c0f2b4fe06b",
    "start_ms": 398300,
    "end_ms": 402700,
    "arabic": "لأنه بالنهاية المجتمع العربي مثلاً كان يئد البنات"
  },
  {
    "id": "69d20da4f8f2e102beb263539ac9cb49",
    "start_ms": 402700,
    "end_ms": 405020,
    "arabic": "يئد البنات"
  },
  {
    "id": "8753f3a0ff1e8c6f1fd4a7b3f13f3518",
    "start_ms": 405020,
    "end_ms": 407520,
    "arabic": "وأحياناً يقتل الأولاد حتى"
  },
  {
    "id": "f6bf1f12df15367c4c0972f94bb7b97c",
    "start_ms": 407520,
    "end_ms": 412880,
    "arabic": "يعني الوأد كان متعلقاً بالبنات لأنه فيه معنيان"
  },
  {
    "id": "4a2fda6c36d962a624e82ec8d864aba8",
    "start_ms": 412880,
    "end_ms": 416340,
    "arabic": "معنى أنها بنت قد تأتي له بالعار"
  },
  {
    "id": "2c6210cf779e3dbf6d416fa05470e6be",
    "start_ms": 416340,
    "end_ms": 420680,
    "arabic": "ومعنى أنه قد يفتقر من أجلها"
  },
  {
    "id": "107405c4fac63db9542cfc2cbc81f9f8",
    "start_ms": 420680,
    "end_ms": 423720,
    "arabic": "ولا تقتلوا أولادكم خشية إملاق"
  },
  {
    "id": "c8a6c9af71d6f196f1fdaa13c46d5fa9",
    "start_ms": 423720,
    "end_ms": 426220,
    "arabic": "وفي الآية الأخرى: ولا تقتلوا أولادكم من إملاق"
  },
  {
    "id": "b2ec7f2a0694f55d49cde100abcd1fcc",
    "start_ms": 426220,
    "end_ms": 430740,
    "arabic": "فأحياناً كانوا يقتلون أولادهم من الذكور والإناث"
  },
  {
    "id": "7b0be24dab25e145ab325e719525f569",
    "start_ms": 430740,
    "end_ms": 432880,
    "arabic": "لكن الإناث كانت أكثر"
  },
  {
    "id": "f9edb5c0e338d01e235096ec3f005c51",
    "start_ms": 432880,
    "end_ms": 438640,
    "arabic": "فبشكل عام الضعفاء في أي مجتمع جاهلي لا بد أن يأكلوا"
  },
  {
    "id": "75b97d5a174bc0b6b6d8df7b1f02ae8e",
    "start_ms": 438640,
    "end_ms": 443380,
    "arabic": "هذا سواء في مجتمع العرب أو في غير مجتمع العرب"
  }
]
